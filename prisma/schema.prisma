generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  googleId     String?  @unique
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations Conversation[]
  progress      UserProgress[]
  userPlan      UserPlan?
  usageLogs     UsageLog[]
  transactions  PaymentTransaction[]

  @@map("users")
}

model Conversation {
  id           String             @id @default(uuid())
  userId       String
  title        String?
  characterId  String
  personality  String
  language     String             @default("en")
  scenarioType String             @default("restaurant")
  difficulty   String             @default("beginner")
  objective    String             @default("")
  summary      Json?
  metrics      Json?
  sessionGoals       Json?
  assistanceState    Json?
  focusScore         Int                @default(100)
  guardRedirectCount Int                @default(0)
  status             ConversationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  audioUrl       String?
  metadata       Json?
  correction     Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model UserProgress {
  id            String    @id @default(cuid())
  userId        String
  language      String
  totalMinutes  Int       @default(0)
  sessionsCount Int       @default(0)
  streakDays    Int       @default(0)
  lastSessionAt DateTime?
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language])
  @@map("user_progress")
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum PlanType {
  FREE
  STARTER
  PRO
  LIFETIME
}

enum PlanStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum UsageType {
  SPEAKING
  CHAT
  TTS
  STT
}

enum TransactionStatus {
  CREATED
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model PaymentTransaction {
  id                String            @id @default(cuid())
  invoiceNumber     String            @unique
  userId            String
  planId            PlanType
  billingProductId  String
  durationMonths    Int
  provider          String
  providerReference String?
  amount            Int
  currency          String            @default("IDR")
  status            TransactionStatus @default(CREATED)
  paymentMethod     String?
  expiredAt         DateTime?
  paidAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice PaymentInvoice?

  @@index([userId, createdAt])
  @@index([providerReference])
  @@map("payment_transactions")
}

model PaymentInvoice {
  id            String        @id @default(cuid())
  transactionId String        @unique
  invoiceNumber String        @unique
  amount        Int
  currency      String        @default("IDR")
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("payment_invoices")
}

model PaymentWebhook {
  id         String   @id @default(cuid())
  provider   String
  payload    Json
  signature  String?
  verified   Boolean  @default(false)
  receivedAt DateTime @default(now())

  @@index([provider, receivedAt])
  @@map("payment_webhooks")
}

model UserPlan {
  id        String     @id @default(cuid())
  userId    String     @unique
  plan      PlanType   @default(FREE)
  status    PlanStatus @default(ACTIVE)
  startedAt DateTime   @default(now())
  expiredAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_plans")
}

model UsageLog {
  id        String    @id @default(cuid())
  userId    String
  type      UsageType
  amount    Int       @default(1)
  metadata  Json?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@map("usage_logs")
}
