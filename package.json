{
  "name": "lingora-be",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4626",
    "build": "next build",
    "start": "next start -p 4626",
    "lint": "eslint",
    "format": "prettier --write --ignore-path=.gitignore .",
    "format:check": "prettier --check --ignore-path=.gitignore .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "loadtest:setup": "tsx load-tests/setup-users.ts",
    "loadtest:smoke": "k6 run load-tests/scenarios/smoke.js",
    "loadtest:chat": "k6 run load-tests/scenarios/chat-quota.js",
    "loadtest:voice": "k6 run load-tests/scenarios/voice-pipeline.js",
    "loadtest:login": "k6 run load-tests/scenarios/login-spike.js",
    "loadtest:all": "npm run loadtest:smoke && npm run loadtest:chat && npm run loadtest:voice && npm run loadtest:login",
    "admin:cost-review": "tsx scripts/cost-review.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.21",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prisma": "^5.22.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
